<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:Efarming_Sustainability.App.Views.Shared"
             x:Class="Efarming_Sustainability.App.Views.Productivity.DashboardProductivity"
             NavigationPage.HasNavigationBar="False"
             Title=""
             BackgroundColor="{StaticResource Primary}">
    <Grid RowDefinitions="Auto,*">
        <shared:BasePages Grid.Row="0" Title="Menu Productividad"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Grid.Row="1" Spacing="25" Padding="30" VerticalOptions="Start">
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <shared:ActionCard Text="Productividad" Image="productivityfarm.png"
                                   Command="{Binding AddProductivityCommand}"/>
                    <shared:ActionCard Text="Plantaciones" Image="planter.png"
                                   Command="{Binding ViewProductivityCommand}"/>
                    <shared:ActionCard Text="Regresar" Image="back.png"
                                   Command="{Binding BackCommand}"/>
                </HorizontalStackLayout>
                
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <shared:ActionCard Text="Cargar Persona" Image="uploadcolor.png"
                    Command="{Binding UploadFUMCommand}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>